#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
PYTHON_BIN="${AEGISROUTE_PYTHON:-python3}"

if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
  printf 'aegisroute: python3 is required\n' >&2
  exit 127
fi

exec "$PYTHON_BIN" "$SCRIPT_DIR/aegisroute.py" "$@"
