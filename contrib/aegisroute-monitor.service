[Unit]
Description=AegisRoute route measurement for Prometheus textfile collector
Documentation=man:aegisroute(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/aegisroute/aegisroute.env
ExecStart=/usr/local/bin/aegisroute ${TARGET} --protocol ${PROTOCOL} --no-enrich --format prometheus --output /var/lib/node_exporter/textfile_collector/aegisroute.prom
User=aegisroute
Group=aegisroute
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/node_exporter/textfile_collector

